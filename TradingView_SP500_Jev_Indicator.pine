//@version=5
indicator("TypeSafe JEV - S&P 500 Multi-Horizon Momentum & Indicative Close Targets", overlay=true, precision=2)

// =========================================================================
// 1. Inputs & Parameters
// =========================================================================
atr_length    = input.int(14, title="ATR Length", minval=1)
rvol_length   = input.int(20, title="RVOL Lookback", minval=1)
rsi_length    = input.int(14, title="RSI Length", minval=1)
show_targets  = input.bool(true, title="Show Indicative Close Target & Stop Lines")
show_table    = input.bool(true, title="Show On-Chart HUD Dashboard Table")
table_pos_str = input.string("Top Right", title="HUD Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"])

// =========================================================================
// 2. Microstructure & Mathematical Feature Engineering
// =========================================================================
session_vwap = ta.vwap(hlc3)
curr_atr     = ta.atr(atr_length)

// VWAP Distance normalized by ATR (Z-score equivalent)
vwap_dist_atr = (close - session_vwap) / (curr_atr + 1e-9)

// Micro-momentum returns across standard multi-bar windows
ret_3b  = (close - close[3]) / (close[3] + 1e-9) * 100.0
ret_6b  = (close - close[6]) / (close[6] + 1e-9) * 100.0
ret_12b = (close - close[12]) / (close[12] + 1e-9) * 100.0

// Relative Volume (RVOL)
avg_vol = ta.sma(volume, rvol_length)
rvol = volume / (avg_vol + 1e-9)

// 14-period RSI
rsi_val = ta.rsi(close, rsi_length)

// Time of Day Classification (US Eastern Time)
t_hour = hour(time, "America/New_York")
t_min  = minute(time, "America/New_York")
t_total_min = t_hour * 60 + t_min

string time_regime = "NORMAL_HOURS"
if (t_total_min >= 570 and t_total_min < 630)      // 09:30 - 10:30
    time_regime := "OPENING_DRIVE"
else if (t_total_min >= 690 and t_total_min < 870) // 11:30 - 14:30
    time_regime := "MIDDAY_LULL"
else if (t_total_min >= 900 and t_total_min <= 960) // 15:00 - 16:00
    time_regime := "POWER_HOUR"

// =========================================================================
// 3. Quantitative Directional Probability & Indicative Close Targets
// =========================================================================
raw_score = 0.40 * math.tanh(ret_3b / 0.35) + 0.35 * math.tanh(vwap_dist_atr / 1.5) + 0.25 * math.tanh(ret_6b / 0.6)
prob_up = 1.0 / (1.0 + math.exp(-(0.19 + 0.35 * raw_score * 3.0)))

string signal_action = "HOLD CASH"
color sig_color = color.yellow
if (prob_up > 0.53 and vwap_dist_atr > 0.10)
    signal_action := "BUY / LONG"
    sig_color := color.green
else if (prob_up < 0.47 and vwap_dist_atr < -0.10)
    signal_action := "SELL / SHORT"
    sig_color := color.red

// Quantitative Target & Protective Stop Calculations
float mult_tp = math.max(1.5 * curr_atr, 0.0030 * close)
float mult_sl = math.max(1.0 * curr_atr, 0.0025 * close)

float ind_close_target = close
float ind_stop_loss = close

if (signal_action == "BUY / LONG")
    float delta_long = math.max(0.6 * mult_tp, 2.0 * (prob_up - 0.50) * mult_tp * 2.0)
    ind_close_target := close + delta_long
    ind_stop_loss    := close - mult_sl * 1.15
else if (signal_action == "SELL / SHORT")
    float delta_short = math.max(0.6 * mult_tp, 2.0 * (0.50 - prob_up) * mult_tp * 2.0)
    ind_close_target := close - delta_short
    ind_stop_loss    := close + mult_sl * 1.15
else
    ind_close_target := close + (prob_up - 0.50) * mult_tp
    ind_stop_loss    := close - mult_sl * 0.75

float target_delta_pct = (ind_close_target - close) / close * 100.0
float stop_delta_pct   = (ind_stop_loss - close) / close * 100.0

// =========================================================================
// 4. Visual Plots on Chart
// =========================================================================
plot(session_vwap, color=color.yellow, linewidth=2, title="Session VWAP")
plot(session_vwap + 1.5 * curr_atr, color=color.new(color.green, 60), linewidth=1, title="VWAP +1.5 ATR")
plot(session_vwap - 1.5 * curr_atr, color=color.new(color.red, 60), linewidth=1, title="VWAP -1.5 ATR")

plot(show_targets ? ind_close_target : na, color=color.new(#00e676, 10), linewidth=2, style=plot.style_circles, title="Indicative Close Target (TP)")
plot(show_targets ? ind_stop_loss : na, color=color.new(#ff5252, 10), linewidth=2, style=plot.style_circles, title="Protective Stop-Loss")

// Bar Color Coding based on Momentum & VWAP
color bar_col = color.gray
if (signal_action == "BUY / LONG")
    bar_col := color.lime
else if (signal_action == "SELL / SHORT")
    bar_col := color.maroon
barcolor(bar_col)

// =========================================================================
// 5. On-Chart Live HUD Dashboard Table
// =========================================================================
var table hud = na
string t_pos = position.top_right
if (table_pos_str == "Bottom Right")
    t_pos := position.bottom_right
else if (table_pos_str == "Top Left")
    t_pos := position.top_left
else if (table_pos_str == "Bottom Left")
    t_pos := position.bottom_left

if show_table and barstate.islast
    hud := table.new(t_pos, 2, 7, bgcolor=color.new(#0f172a, 15), border_width=1, border_color=color.new(#38bdf8, 50))
    table.cell(hud, 0, 0, "⚡ TypeSafe Jev AI", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, syminfo.ticker, bgcolor=color.new(#1e293b, 10), text_color=color.yellow, text_size=size.small)

    table.cell(hud, 0, 1, "Action", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 1, signal_action, bgcolor=color.new(sig_color, 80), text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 2, "$" + str.tostring(close, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "🎯 Close Target (TP)", text_color=#38bdf8, text_size=size.small)
    table.cell(hud, 1, 3, "$" + str.tostring(ind_close_target, "#.##") + " (" + (target_delta_pct >= 0 ? "+" : "") + str.tostring(target_delta_pct, "#.##") + "%)", text_color=#38bdf8, text_size=size.small)

    table.cell(hud, 0, 4, "🛡️ Stop Loss", text_color=#f87171, text_size=size.small)
    table.cell(hud, 1, 4, "$" + str.tostring(ind_stop_loss, "#.##") + " (" + str.tostring(stop_delta_pct, "#.##") + "%)", text_color=#f87171, text_size=size.small)

    table.cell(hud, 0, 5, "P(Continuation)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(prob_up * 100.0, "#.#") + "%", text_color=sig_color, text_size=size.small)

    table.cell(hud, 0, 6, "VWAP Distance", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 6, (vwap_dist_atr >= 0 ? "+" : "") + str.tostring(vwap_dist_atr, "#.##") + " ATR", text_color=color.white, text_size=size.small)

// =========================================================================
// 6. Alert Construction for TypeSafe JEV Webhook
// =========================================================================
if barstate.isconfirmed
    alert_msg = "{" +
      "\"symbol\":\"" + syminfo.ticker + "\"," +
      "\"timeframe\":\"" + timeframe.period + "\"," +
      "\"close\":" + str.tostring(close, "#.##") + "," +
      "\"action\":\"" + signal_action + "\"," +
      "\"indicative_close_target\":" + str.tostring(ind_close_target, "#.##") + "," +
      "\"indicative_stop_loss\":" + str.tostring(ind_stop_loss, "#.##") + "," +
      "\"prob_up\":" + str.tostring(prob_up, "#.####") + "," +
      "\"vwap\":" + str.tostring(session_vwap, "#.##") + "," +
      "\"vwap_z\":" + str.tostring(vwap_dist_atr, "#.##") + "," +
      "\"ret_15m\":" + str.tostring(ret_3b, "#.##") + "," +
      "\"ret_30m\":" + str.tostring(ret_6b, "#.##") + "," +
      "\"ret_60m\":" + str.tostring(ret_12b, "#.##") + "," +
      "\"rvol\":" + str.tostring(rvol, "#.##") + "," +
      "\"rsi\":" + str.tostring(rsi_val, "#.#") + "," +
      "\"time_regime\":\"" + time_regime + "\"" +
      "}"

    alert(alert_msg, alert.freq_once_per_bar_close)
